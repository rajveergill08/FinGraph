# Kafka producer settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_HOST_PORT=9092
KAFKA_TRANSACTION_TOPIC=fingraph.transactions.v1
KAFKA_CLIENT_ID=fingraph-simulator
KAFKA_TRANSACTION_TOPIC_PARTITIONS=3
KAFKA_TRANSACTION_TOPIC_REPLICATION_FACTOR=1

# Neo4j development settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-now
