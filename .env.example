# Kafka producer settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_HOST_PORT=9092
KAFKA_TRANSACTION_TOPIC=fingraph.transactions.v1
KAFKA_CLIENT_ID=fingraph-simulator
KAFKA_TRANSACTION_TOPIC_PARTITIONS=3
KAFKA_TRANSACTION_TOPIC_REPLICATION_FACTOR=1
KAFKA_DEAD_LETTER_TOPIC=fingraph.transactions.dlq.v1
KAFKA_CONSUMER_GROUP=fingraph-neo4j-v1
FLINK_KAFKA_CONNECTOR_JAR=.flink/lib/flink-sql-connector-kafka-3.3.0-1.20.jar
FLINK_PYTHON_EXECUTION_MODE=process
FLINK_PARALLELISM=1
FLINK_PYTHON_BUNDLE_SIZE=50
FLINK_PYTHON_BUNDLE_TIME_MS=50

# Neo4j development settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-now
